# Fraud Detection API Configuration
# ==================================
# Copy this file to .env and update values as needed

# =============================================================================
# API Settings
# =============================================================================
APP_NAME="Fraud Detection API"
APP_VERSION="0.2.0"
DEBUG=false

# =============================================================================
# DATABASE CONFIGURATION (NEW)
# =============================================================================

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fraud_detection

# Redis connection string for caching
REDIS_URL=redis://localhost:6379/0

# Enable SQL query logging (set to true for debugging)
SQL_ECHO=true

# =============================================================================
# AUTHENTICATION (NEW)
# =============================================================================

# JWT secret key - CHANGE THIS IN PRODUCTION!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=any_random_key_would_do_for_test

# Token expiration settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# LLM/AI API KEYS
# =============================================================================
GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ENABLE_LLM=true

# MODELS BASE URLS
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OLLAMA_BASE_URL=http://localhost:11434/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1

# MODEL VERSIONS
GPT5_MODEL=gpt-5-nano
GEMINI_MODEL=gemini-2.5-flash
GEMINI_3_FLASH=gemini/gemini-3-flash-preview
LLAMA_3.3_MODEL=groq/llama-3.3-70b-versatile

# =============================================================================
# EXTERNAL SERVICES (NEW)
# =============================================================================

# IPinfo.io token for IP intelligence
# Get one at: https://ipinfo.io/ (free tier available)
IPINFO_TOKEN=

# MaxMind license key for GeoIP2 database
# Get one at: https://www.maxmind.com/
MAXMIND_LICENSE_KEY=

# Abstract API key for email validation
# Get one at: https://www.abstractapi.com/
ABSTRACT_API_KEY=

# =============================================================================
# WEBHOOK SECURITY (NEW)
# =============================================================================

# Secret key for verifying incoming webhooks
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# =============================================================================
# Server Settings
# =============================================================================
HOST=0.0.0.0
PORT=8000

# CORS Settings (comma-separated list of allowed origins)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# =============================================================================
# Fraud Detection Settings
# =============================================================================
# Risk score threshold for automatic investigation (0-100)
AUTO_INVESTIGATE_THRESHOLD=60.0
# Risk score threshold for high-risk classification (0-100)
HIGH_RISK_THRESHOLD=60.0

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
